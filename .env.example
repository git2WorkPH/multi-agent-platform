LOCAL_AWS_ENDPOINT=http://127.0.0.1:4566
AWS_REGION=us-east-1
LOCAL_AWS_ACCESS_KEY_ID=test
LOCAL_AWS_SECRET_ACCESS_KEY=test
LOCAL_RESOURCE_PREFIX=multi-agent
AI_PROVIDER=mock
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_MS=120000
OLLAMA_RETRIES=1
# OLLAMA_NUM_GPU=0
CONSOLIDATION_DEBOUNCE_MS=3000
CONSOLIDATION_LEASE_MS=600000
API_HOST=127.0.0.1
API_PORT=3000
# Loopback-only demo access. For token mode, set API_AUTH_MODE=token and API_AUTH_CONFIG.
API_AUTH_MODE=development
API_DEV_PROJECTS=demo

# Dashboard development server and optional API proxy override
DASHBOARD_PORT=5174
# DASHBOARD_API_URL=http://127.0.0.1:3000

# Optional agent scope overrides
# AGENT_PROJECT_ID=demo
# AGENT_TOPIC=sample
# AGENT_CORRELATION_ID=demo-run

# Optional consolidation expectations
# CONSOLIDATION_EXPECTED_AGENTS=research,analysis
# CONSOLIDATION_STALE_MS=86400000
