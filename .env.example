# Copy to .env for the local Mock demo. The active values below are sufficient.
# Keep .env private. Shell variables override values read by dotenv.

# Floci and local AWS SDK clients
# If you change FLOCI_PORT, update LOCAL_AWS_ENDPOINT to match.
FLOCI_PORT=4566
LOCAL_AWS_ENDPOINT=http://127.0.0.1:4566
AWS_REGION=us-east-1
LOCAL_AWS_ACCESS_KEY_ID=test
LOCAL_AWS_SECRET_ACCESS_KEY=test
LOCAL_RESOURCE_PREFIX=multi-agent

# API and dashboard
API_HOST=127.0.0.1
API_PORT=3000
DASHBOARD_PORT=5174
# The dashboard normally proxies to 127.0.0.1 using API_PORT.
# DASHBOARD_API_URL=http://127.0.0.1:3000

# Loopback-only demo access. Use comma-separated project IDs for multiple grants.
API_AUTH_MODE=development
API_DEV_PROJECTS=demo
# For token mode, set API_AUTH_MODE=token above and set API_AUTH_CONFIG.
# Generate a private bearer token of at least 32 characters.
# API_AUTH_CONFIG='[{"token":"REPLACE_WITH_YOUR_PRIVATE_TOKEN","projects":["demo"]}]'
# NODE_ENV=production disables development authentication.

# AI provider. Mock needs no Ollama server or model.
AI_PROVIDER=mock
# Set AI_PROVIDER=ollama above to use an installed local model.
# OLLAMA_PORT applies to the optional Docker Compose Ollama service.
# If you change OLLAMA_PORT, update OLLAMA_BASE_URL to match.
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_MS=120000
OLLAMA_RETRIES=1
# Set to zero for CPU-only inference.
# OLLAMA_NUM_GPU=0

# Consolidation
CONSOLIDATION_DEBOUNCE_MS=3000
CONSOLIDATION_LEASE_MS=600000
# CONSOLIDATION_EXPECTED_AGENTS=research,analysis
# CONSOLIDATION_STALE_MS=86400000
# Set only when retrying the same standalone consolidation run.
# CONSOLIDATION_RUN_ID=00000000-0000-4000-8000-000000000001

# Optional agent scope and input overrides. Both agents share the demo defaults.
# AGENT_PROJECT_ID=demo
# AGENT_TOPIC=sample
# AGENT_CORRELATION_ID=demo-run
# RESEARCH_FIXTURE=agents/research-agent/fixture.json
# ANALYSIS_FIXTURE=agents/analysis-agent/fixture.json

# Set result ID and revision only when managing a specific result's history.
# Set event ID and timestamp too when replaying an identical publication.
# Use a different result and event ID for each independent publication.
# AGENT_RESULT_ID=example-result
# AGENT_REVISION=1
# AGENT_EVENT_ID=00000000-0000-4000-8000-000000000002
# AGENT_OCCURRED_AT=2026-11-08T00:00:00.000Z

# Optional Gmail urgency agent. Set a Google Desktop OAuth client ID for browser sign-in.
# Add email to API_DEV_PROJECTS (or grant it in API_AUTH_CONFIG) to view its results.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET= # Supply if required by your Desktop client or for offline mode.
# GMAIL_REFRESH_TOKEN= # Optional legacy offline mode.
# GMAIL_SCAN_LIMIT=15
# GMAIL_ACCOUNT_INDEX=0

# Optional macOS machine review. Add machine to API_DEV_PROJECTS or the token grant.
# Folder paths are relative to your home directory. Applications means ~/Applications.
# MACHINE_SCAN_FOLDERS='["Downloads","Desktop","Applications"]'
# MACHINE_SCAN_OLDER_DAYS=90
# MACHINE_SCAN_MAX_ENTRIES=1000
