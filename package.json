{
  "name": "multi-agent-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:floci": "vitest run tests/integration",
    "bootstrap": "node infrastructure/bootstrap/resources.ts",
    "agent:research": "node agents/research-agent/run.ts",
    "agent:analysis": "node agents/analysis-agent/run.ts",
    "consume:results": "node apps/result-consumer/run.ts",
    "test:ollama": "vitest run tests/ollama/",
    "consolidate": "node apps/consolidation-worker/run-once.ts",
    "api": "node apps/api/run.ts",
    "work:consolidation": "node apps/consolidation-worker/run.ts",
    "dashboard": "pnpm --filter @multi-agent-platform/dashboard dev",
    "build:dashboard": "pnpm --filter @multi-agent-platform/dashboard build",
    "test:e2e": "playwright test",
    "test:ollama-stack": "vitest run tests/ollama-stack"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1163.0",
    "@aws-sdk/client-s3": "^3.1163.0",
    "@aws-sdk/client-sqs": "^3.1163.0",
    "@fastify/swagger": "^9.9.3",
    "fastify": "^5.12.8",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
